# Copy to .env and fill in.
# - docker compose passes it to the api and worker containers, overriding
#   DATABASE_URL, the Celery URLs and MLFLOW_TRACKING_URI with container hostnames.
# - In local development the flask CLI loads it automatically (python-dotenv).

FLASK_APP=gated_finetune.app

# SQLite path is relative to Flask's instance/ folder (-> instance/data.db)
DATABASE_URL=sqlite:///data.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Required for predictions: they log first-inference artifacts to the model's run
MLFLOW_TRACKING_URI=http://localhost:5001

# Where uploaded model pickles are stored
MODELS_DIR=models

# Optional: require an X-API-Key header on every request except / and /metrics
API_KEY=

# Optional: Arize monitoring, off unless ARIZE_ENABLED=true
ARIZE_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_ENVIRONMENT=production

# Optional: local LLM (Ollama) used by GET /predictions/<id>/explainer
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
