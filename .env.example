# Copy to .env and fill in. docker-compose overrides the database, broker, and MLflow URLs.
DATABASE_URL=sqlite:///data.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5001

# Optional: require an X-API-Key header on every request
API_KEY=

# Optional: Arize monitoring
ARIZE_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_KEY=

# Optional: local LLM for prediction explanations
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
